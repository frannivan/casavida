            "date": 1771542995358,
            "name": "Commit-0",
            "content": "<div class=\"row mb-3\">\n    <div class=\"col-12\">\n        <div *ngIf=\"errorMessage\" class=\"alert alert-danger shadow-sm\">\n            <i class=\"fas fa-exclamation-triangle mr-2\"></i> <strong>Error:</strong> {{ errorMessage }}\n        </div>\n        <div *ngIf=\"isLoading\" class=\"alert alert-info shadow-sm\">\n            <i class=\"fas fa-spinner fa-spin mr-2\"></i> Cargando usuarios...\n        </div>\n        <div *ngIf=\"!isLoading && !errorMessage && users.length === 0\" class=\"alert alert-warning shadow-sm\">\n            <i class=\"fas fa-info-circle mr-2\"></i> No se encontraron usuarios registrados. (Lista vacía)\n        </div>\n    </div>\n</div>\n\n<div class=\"row\">\n    <div class=\"col-12 d-flex justify-content-between align-items-center mb-4\">\n        <h2>Gestión de Usuarios</h2>\n        <button class=\"btn btn-primary\" (click)=\"openCreateModal()\">\n            <i class=\"fas fa-user-plus mr-2\"></i>Nuevo Usuario\n        </button>\n    </div>\n</div>\n\n<!-- Filter Section -->\n<div class=\"card mb-3 shadow-sm\">\n    <div class=\"card-body\">\n        <div class=\"row g-3\">\n            <div class=\"col-md-6\">\n                <label class=\"form-label fw-bold\">Buscar por Nombre o Email</label>\n                <input type=\"text\" \n                       class=\"form-control\" \n                       [(ngModel)]=\"searchTerm\" \n                       (input)=\"filterUsers()\"\n                       placeholder=\"Escribe para filtrar...\">\n            </div>\n            <div class=\"col-md-4\">\n                <label class=\"form-label fw-bold\">Filtrar por Rol</label>\n                <select class=\"form-select\" [(ngModel)]=\"roleFilter\" (change)=\"filterUsers()\">\n                    <option value=\"\">Todos los roles</option>\n                    <option value=\"ADMIN\">Admin</option>\n                    <option value=\"VENDEDOR\">Vendedor</option>\n                    <option value=\"RECEPCION\">Recepción</option>\n                    <option value=\"USER\">Usuario</option>\n                </select>\n            </div>\n            <div class=\"col-md-2 d-flex align-items-end\">\n                <button class=\"btn btn-secondary w-100\" (click)=\"clearFilters()\">\n                    <i class=\"fas fa-times me-1\"></i>Limpiar\n                </button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class=\"card shadow\">\n   \n</div>\n\n<!-- Modal -->\n<div class=\"modal fade\" [ngClass]=\"{'show d-block': showModal}\" tabindex=\"-1\" *ngIf=\"showModal\">\n    <div class=\"modal-dialog\">\n        <div class=\"modal-content\">\n            <div class=\"modal-header\">\n                <h5 class=\"modal-title\">{{ isEditing ? 'Editar Usuario' : 'Nuevo Usuario' }}</h5>\n                <button type=\"button\" class=\"close\" (click)=\"closeModal()\">\n                    <span>&times;</span>\n                </button>\n            </div>\n            <div class=\"modal-body\">\n                <div class=\"form-group\">\n                    <label>Username</label>\n                    <input type=\"text\" class=\"form-control\" [(ngModel)]=\"currentUser.username\">\n                </div>\n                <div class=\"form-group\">\n                    <label>Email</label>\n                    <input type=\"email\" class=\"form-control\" [(ngModel)]=\"currentUser.email\">\n                </div>\n                <div class=\"form-group\">\n                    <label>Password {{ isEditing ? '(vacío para mantener)' : '' }}</label>\n                    <input type=\"password\" class=\"form-control\" [(ngModel)]=\"currentUser.password\">\n                </div>\n                <div class=\"form-group\">\n                    <label>Rol</label>\n                    <select class=\"form-control\" [(ngModel)]=\"currentUser.role\">\n                        <option value=\"\">Seleccionar rol...</option>\n                        <option *ngFor=\"let role of roles\" [value]=\"role\">{{ role }}</option>\n                    </select>\n                </div>\n            </div>\n            <div class=\"modal-footer\">\n                <button type=\"button\" class=\"btn btn-secondary\" (click)=\"closeModal()\">Cancelar</button>\n                <button type=\"button\" class=\"btn btn-primary\" (click)=\"saveUser()\">Guardar</button>\n            </div>\n        </div>\n    </div>\n</div>\n<div class=\"modal-backdrop fade show\" *ngIf=\"showModal\"></div>"
        }
    ]
}