            "date": 1771539752604,
            "name": "Commit-0",
            "content": "<div id=\"app\">\n  <!-- Layout with Sidebar for Admin/Recepcion/Vendedor -->\n  <ng-container *ngIf=\"showAdminBoard || showRecepcionBoard || showVendedorBoard; else publicLayout\">\n    <div class=\"d-flex\" id=\"wrapper\">\n      <!-- Sidebar -->\n      <app-sidebar></app-sidebar>\n\n      <!-- Page Content -->\n      <div id=\"page-content-wrapper\" style=\"margin-left: 250px; width: 100%;\">\n        <!-- Top Navbar (Premium Admin Look) -->\n        <nav class=\"navbar navbar-expand navbar-light bg-white border-bottom shadow-sm py-2\">\n          <div class=\"container-fluid\">\n            <a href=\"#\" class=\"navbar-brand ms-3 fw-bold text-primary\" routerLink=\"home\">\n              <i class=\"fas fa-home\"></i> CasaVida\n            </a>\n            <ul class=\"navbar-nav ms-auto me-3 align-items-center\">\n              <li class=\"nav-item me-3\">\n                <span class=\"badge bg-soft-primary text-primary border border-primary-soft\">\n                  <i class=\"fas fa-user-shield\" *ngIf=\"showAdminBoard\"></i>\n                  <i class=\"fas fa-user-tie\" *ngIf=\"showVendedorBoard\"></i>\n                  <i class=\"fas fa-concierge-bell\" *ngIf=\"showRecepcionBoard\"></i>\n                  {{ username }} <span class=\"text-muted fw-normal ms-1\">({{ userRoleDisplay }})</span>\n                </span>\n              </li>\n              <li class=\"nav-item dropdown\">\n                <a class=\"nav-link dropdown-toggle d-flex align-items-center\" href=\"#\" role=\"button\" data-bs-toggle=\"dropdown\">\n                  <div class=\"avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-1\" style=\"width: 32px; height: 32px;\">\n                    {{ username?.substring(0,1)?.toUpperCase() }}\n                  </div>\n                </a>\n                <ul class=\"dropdown-menu dropdown-menu-end shadow border-0\">\n                  <li><a class=\"dropdown-item py-2\" routerLink=\"/profile\"><i class=\"fas fa-user me-2\"></i> Mi Perfil</a></li>\n                  <li>\n                    <a class=\"dropdown-item py-2 d-flex justify-content-between align-items-center\" routerLink=\"/mensajes\">\n                      <span><i class=\"fas fa-envelope me-2\"></i> Mensajes</span>\n                      <span *ngIf=\"unreadMessagesCount > 0\" class=\"badge bg-danger rounded-pill\">{{ unreadMessagesCount }}</span>\n                    </a>\n                  </li>\n                  <li><hr class=\"dropdown-divider\"></li>\n                  <li><a class=\"dropdown-item py-2 text-danger\" style=\"cursor: pointer;\" (click)=\"logout()\"><i class=\"fas fa-sign-out-alt me-2\"></i> Salir</a></li>\n                </ul>\n              </li>\n            </ul>\n          </div>\n        </nav>\n\n        <!-- Main Content -->\n        <div class=\"container-fluid py-3\">\n          <router-outlet></router-outlet>\n        </div>\n      </div>\n    </div>\n  </ng-container>\n\n  <!-- Standard Layout for Public/User (No Sidebar) -->\n  <ng-template #publicLayout>\n    <nav class=\"navbar navbar-expand-lg navbar-dark bg-dark shadow py-3\">\n      <div class=\"container\">\n        <a href=\"#\" class=\"navbar-brand fw-bold fs-4\" routerLink=\"home\">\n           <span class=\"text-primary\">Casa</span>Vida\n        </a>\n        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarPublic\">\n          <span class=\"navbar-toggler-icon\"></span>\n        </button>\n        \n        <div class=\"collapse navbar-collapse\" id=\"navbarPublic\">\n          <ul class=\"navbar-nav me-auto mb-2 mb-lg-0\">\n            <li class=\"nav-item\">\n              <a href=\"/home\" class=\"nav-link\" routerLink=\"home\"><i class=\"fas fa-home me-1\"></i> Inicio</a>\n            </li>\n            <li class=\"nav-item\" *ngIf=\"showUserBoard\">\n              <a href=\"/user\" class=\"nav-link\" routerLink=\"user\">Panel Cliente</a>\n            </li>\n          </ul>\n\n          <ul class=\"navbar-nav ms-auto align-items-center\">\n            <ng-container *ngIf=\"!isLoggedIn; else userLoggedIn\">\n              <li class=\"nav-item\">\n                <a href=\"/register\" class=\"nav-link\" routerLink=\"register\">Registrarse</a>\n              </li>\n              <li class=\"nav-item ms-lg-2\">\n                <a href=\"/login\" class=\"btn btn-outline-light px-4\" routerLink=\"login\">Ingresar</a>\n              </li>\n            </ng-container>\n            <ng-template #userLoggedIn>\n              <!-- Message Icon with Badge -->\n              <li class=\"nav-item me-2\">\n                <a routerLink=\"/mensajes\" class=\"nav-link position-relative\">\n                  <i class=\"fas fa-envelope fs-5\"></i>\n                  <span *ngIf=\"unreadMessagesCount > 0\" class=\"position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger\" style=\"font-size: 0.6rem;\">\n                    {{ unreadMessagesCount }}\n                  </span>\n                </a>\n              </li>\n              \n              <li class=\"nav-item dropdown\">\n                <a class=\"nav-link dropdown-toggle d-flex align-items-center\" href=\"#\" role=\"button\" data-bs-toggle=\"dropdown\">\n                  <i class=\"fas fa-user-circle fs-5 me-1\"></i> {{ username }}\n                </a>\n                <ul class=\"dropdown-menu dropdown-menu-end shadow border-0\">\n                  <li><a class=\"dropdown-item py-2\" routerLink=\"/profile\"><i class=\"fas fa-user me-2\"></i> Mi Perfil</a></li>\n                  <li>\n                    <a class=\"dropdown-item py-2 d-flex justify-content-between align-items-center\" routerLink=\"/mensajes\">\n                      <span><i class=\"fas fa-envelope me-2\"></i> Mensajes!!!</span>\n                      <span *ngIf=\"unreadMessagesCount > 0\" class=\"badge bg-danger rounded-pill\">{{ unreadMessagesCount }}</span>\n                    </a>\n                  </li>\n                  <li><hr class=\"dropdown-divider\"></li>\n                  <li><a class=\"dropdown-item py-2 text-danger\" style=\"cursor: pointer;\" (click)=\"logout()\"><i class=\"fas fa-sign-out-alt me-2\"></i> Salir</a></li>\n                </ul>\n              </li>\n            </ng-template>\n          </ul>\n        </div>\n      </div>\n    </nav>\n\n    <div class=\"container mt-3\">\n      <router-outlet></router-outlet>\n    </div>\n  </ng-template>\n\n  <!-- Chatbot (Always visible) -->\n  <app-chatbot></app-chatbot>\n</div>"
        }
    ]
}