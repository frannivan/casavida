            "date": 1771536742098,
            "name": "Commit-0",
            "content": "<div class=\"container mt-4\">\n    <div class=\"row align-items-center mb-4\">\n        <div class=\"col\">\n            <h2 class=\"fw-bold\"><i class=\"fas fa-envelope-open-text text-primary me-2\"></i>Centro de Mensajes</h2>\n        </div>\n        <div class=\"col-auto\">\n            <button class=\"btn btn-primary px-4 py-2 shadow-sm rounded-pill\" (click)=\"switchTab('nuevo')\">\n                <i class=\"fas fa-plus me-2\"></i> Nuevo Mensaje\n            </button>\n        </div>\n    </div>\n\n    <div >\n        <div>\n            <ul >\n                <li class=\"nav-item\">\n                    <a class=\"nav-link py-2\" [class.active]=\"activeTab === 'recibidos'\" href=\"javascript:void(0)\" (click)=\"switchTab('recibidos')\">\n                        <i class=\"fas fa-inbox me-2\"></i> Recibidos\n                    </a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link py-2\" [class.active]=\"activeTab === 'enviados'\" href=\"javascript:void(0)\" (click)=\"switchTab('enviados')\">\n                        <i class=\"fas fa-paper-plane me-2\"></i> Enviados\n                    </a>\n                </li>\n            </ul>\n        </div>\n\n        <div class=\"card-body p-0\">\n            <!-- Loading Indicator -->\n            <div *ngIf=\"isLoading\" class=\"text-center py-5\">\n                <div class=\"spinner-border text-primary\" role=\"status\"></div>\n                <p class=\"mt-2 text-muted\">Cargando mensajes...</p>\n            </div>\n\n            <!-- List of Messages -->\n            <div *ngIf=\"!isLoading && activeTab !== 'nuevo'\">\n                <div class=\"list-group list-group-flush\" *ngIf=\"mensajes.length > 0\">\n                    <div *ngFor=\"let msg of mensajes\" \n                        class=\"list-group-item list-group-item-action border-0 px-4 py-3 mb-1\"\n                        [class.bg-light]=\"!msg.leido && activeTab === 'recibidos'\"\n                        style=\"transition: background 0.2s;\"\n                        (click)=\"marcarLeido(msg)\">\n                        \n                        <div class=\"d-flex w-100 justify-content-between align-items-center\">\n                            <h6 class=\"mb-1 text-primary fw-bold\">\n                                <span *ngIf=\"!msg.leido && activeTab === 'recibidos'\" class=\"badge bg-primary me-2\">Nuevo</span>\n                                {{ msg.asunto }}\n                            </h6>\n                            <small class=\"text-muted\">{{ msg.fechaEnvio | date:'short' }}</small>\n                        </div>\n                        <p class=\"mb-1 text-dark\">{{ msg.contenido }}</p>\n                        <small class=\"text-muted\">\n                            <i class=\"fas fa-user-circle me-1\"></i>\n                            <span *ngIf=\"activeTab === 'recibidos'\">De: {{ msg.remitente?.username }}</span>\n                            <span *ngIf=\"activeTab === 'enviados'\">Para: {{ msg.destinatario?.username }}</span>\n                        </small>\n                    </div>\n                </div>\n                <div *ngIf=\"mensajes.length === 0\" class=\"text-center py-5 text-muted\">\n                    <i class=\"fas fa-comment-slash fa-3x mb-3 opacity-25\"></i>\n                    <p>No hay mensajes en esta bandeja.</p>\n                </div>\n            </div>\n\n            <!-- New Message Form -->\n            <div *ngIf=\"activeTab === 'nuevo'\" class=\"p-4\">\n                <div class=\"row justify-content-center\">\n                    <div class=\"col-lg-8\">\n                        <div class=\"mb-3\">\n                            <label class=\"form-label fw-bold\">Destinatario</label>\n                            <select class=\"form-select border-0 bg-light py-2\" [(ngModel)]=\"newMessage.destinatarioId\">\n                                <option value=\"0\">Seleccionar usuario...</option>\n                                <option *ngFor=\"let u of usuarios\" [value]=\"u.id\">{{ u.username }} ({{ u.email }})</option>\n                            </select>\n                        </div>\n                        <div class=\"mb-3\">\n                            <label class=\"form-label fw-bold\">Asunto</label>\n                            <input type=\"text\" class=\"form-control border-0 bg-light py-2\" [(ngModel)]=\"newMessage.asunto\" placeholder=\"¿Sobre qué es el mensaje?\">\n                        </div>\n                        <div class=\"mb-3\">\n                            <label class=\"form-label fw-bold\">Contenido</label>\n                            <textarea class=\"form-control border-0 bg-light\" rows=\"5\" [(ngModel)]=\"newMessage.contenido\" placeholder=\"Escribe tu mensaje aquí...\"></textarea>\n                        </div>\n                        <div class=\"d-grid gap-2 d-md-flex justify-content-md-end\">\n                            <button class=\"btn btn-light px-4 py-2 me-md-2\" (click)=\"switchTab('recibidos')\">Cancelar</button>\n                            <button class=\"btn btn-primary px-5 py-2\" (click)=\"enviar()\">\n                                <i class=\"fas fa-paper-plane me-2\"></i> Enviar Mensaje\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n"
        }
    ]
}